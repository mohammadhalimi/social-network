generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  fullName  String
  bio       String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  posts     Post[]
  comments  Comment[]
  likes     Like[]
  commentLikes CommentLike[]
  following Follow[] @relation("Following") 
  followers Follow[] @relation("Followers") 

  // ✅ روابط جدید مربوط به استوری
  stories         Story[]
  storyViews      StoryView[]
  closeFriendsOf  CloseFriend[] @relation("CloseFriendsOwner")   // لیستی که خودم مدیریت می‌کنم
  closeFriendedBy CloseFriend[] @relation("CloseFriendsMember")  // کسانی که منو به‌عنوان close friend گذاشتن
}

model Post {
  id        String   @id @default(cuid())
  content   String   @db.Text   // محتوای JSON
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isPublished Boolean @default(true)
  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String? 
  parent    Comment? @relation("replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("replies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     CommentLike[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, postId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, commentId])
}

model Follow {
  id          String   @id @default(cuid())

  followerId  String   // کسی که فالو می‌کنه
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String   // کسی که فالو می‌شه
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// =============================================
// ✅ مدل‌های جدید: Story
// =============================================

enum StoryVisibility {
  PUBLIC
  FOLLOWERS
  CLOSE_FRIENDS
}

model Story {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl   String
  mediaType  String          // "image" | "video"
  visibility StoryVisibility @default(FOLLOWERS)
  createdAt  DateTime        @default(now())
  expiresAt  DateTime        // createdAt + مدت انتخابی کاربر
  views      StoryView[]
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
}

// ✅ مدل جدید: دوستان نزدیک
model CloseFriend {
  id String @id @default(cuid())

  ownerId String // کسی که این لیست رو مدیریت می‌کنه
  owner   User   @relation("CloseFriendsOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  friendId String // کاربری که به‌عنوان دوست نزدیک انتخاب شده
  friend   User   @relation("CloseFriendsMember", fields: [friendId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ownerId, friendId])
}