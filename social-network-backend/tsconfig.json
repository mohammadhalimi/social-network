{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "rootDir": "./src",
     "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test-minimal.ts", "test-minimal.js"],
  "exclude": ["node_modules", "dist"]
}